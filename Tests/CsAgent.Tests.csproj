<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<InvariantGlobalization>true</InvariantGlobalization>
		<IsPackable>false</IsPackable>
		<!-- Test.Sdk would generate its own Main; Program.cs already has one. -->
		<GenerateProgramFile>false</GenerateProgramFile>
		<!-- Reproduce the AOT constraint: reflection-based System.Text.Json is disabled,
		     so any JsonSerializer.Serialize<T>() slipping into the code fails the tests. -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<NoWarn>$(NoWarn);CS8632;CS0168;CS0219;CS0162;CA1416</NoWarn>
	</PropertyGroup>

	<!-- The app is a Web SDK / NativeAOT project; instead of referencing it, the tests compile
	     the same sources directly. UI-only files (documentation / help display) and the
	     Presentation and Infrastructure layers are left out. Only test-only NuGet packages are used (the app itself stays zero-dependency). -->
	<ItemGroup>
		<Compile Include="../Core/**/*.cs" />
		<Compile Include="../Services/**/*.cs" />
		<Compile Include="../Shared/**/*.cs"
		         Exclude="../Shared/DocDisplay.cs;../Shared/HelpDisplay.cs" />
		<!-- Console output of the CLI (self-contained: only needs Shared). -->
		<Compile Include="../Presentation/Tui/ConsoleObserver.cs" />
		<Compile Include="../Presentation/Tui/ConsoleRenderer.cs" />
		<Compile Include="*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="MSTest.TestFramework" Version="*" />
		<PackageReference Include="MSTest.TestAdapter" Version="*" />
	</ItemGroup>

</Project>
