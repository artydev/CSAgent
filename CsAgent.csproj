<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<DebugType>none</DebugType>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<!-- DebugType controls the MANAGED (Roslyn) compiler's PDB. NativeAOT's
             ILC toolchain generates its own, separate native debug symbols
             regardless of DebugType — StripSymbols is the property that
             actually suppresses that native .pdb output. -->
		<StripSymbols>true</StripSymbols>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>AnyCPU;x64</Platforms>
		<!-- This is a Web SDK project but does not use ASP.NET Core's static web
         assets pipeline (UI assets are embedded resources served via manual
         Minimal API endpoints instead). Disabling this removes the unused
         CsAgent.staticwebassets.endpoints.json artifact from publish. -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<!-- Release configurations intentionally do NOT override DebugType here —
       they inherit "none" from the top-level PropertyGroup above. Previous
       Release|AnyCPU and Release|x64 overrides forcing DebugType=full were
       generating a ~79 MB .pdb into every Release publish, unintentionally. -->

	<ItemGroup>
		<!-- Standalone tool projects and build output must not be compiled into the app. -->
		<Compile Remove="tools/**/*.cs" />
		<!-- The test project lives in Tests/ and has its own entry point. -->
		<Compile Remove="Tests/**" />
		<Content Remove="Tests/**" />
		<EmbeddedResource Remove="Tests/**" />
		<None Remove="Tests/**" />
		<Compile Remove="obj/**/*.cs" />
		<Compile Remove="bin/**/*.cs" />
		<Compile Remove="wwwroot\**" />
		<Content Remove="wwwroot\**" />
		<EmbeddedResource Remove="tools/**" />
		<EmbeddedResource Remove="wwwroot\**" />
		<None Remove="tools/**" />
		<None Remove="wwwroot\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- README.md is intentionally NOT copied to the publish directory —
         publish output is kept to CsAgent.exe + skills/ only. It remains
         available in the repo itself for anyone browsing source. -->
		<Content Include="skills\**">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- Routing rules you can edit by hand (found next to the exe when there is none in the working directory). -->
		<Content Update="LLMRoutingRules\**">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Presentation\Web\assets\**" />
		<EmbeddedResource Include="Presentation\LeanUI\assets\**" />
		<!-- Shown by the doc command (DocDisplay, StaticAssets.ReadmeMd). -->
		<EmbeddedResource Include="README.md" LogicalName="CsAgent.README.md" />
	</ItemGroup>

</Project>